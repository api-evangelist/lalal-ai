                              "raw": "{\n  \"source_id\": \"<string>\",\n  \"presets\": {\n    \"stem\": \"wind\",\n    \"splitter\": \"auto\",\n    \"dereverb_enabled\": false,\n    \"encoder_format\": \"aac\",\n    \"multivocal\": \"<string>\",\n    \"extraction_level\": \"deep_extraction\"\n  },\n  \"idempotency_key\": \"<string>\"\n}",
