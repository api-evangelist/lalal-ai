                        "body": {
                          "mode": "raw",
                          "raw": "{\n  \"source_id\": \"<string>\",\n  \"presets\": {\n    \"stem_list\": [\n      \"bass\"\n    ],\n    \"splitter\": \"auto\",\n    \"dereverb_enabled\": false,\n    \"encoder_format\": \"mp3\",\n    \"extraction_level\": \"deep_extraction\"\n  },\n  \"idempotency_key\": \"<string>\"\n}",
