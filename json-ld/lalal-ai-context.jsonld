{
  "@context": {
    "@version": 1.1,
    "schema": "https://schema.org/",
    "lalal": "https://www.lalal.ai/ns/",
    "name": "schema:name",
    "description": "schema:description",
    "url": "schema:url",
    "identifier": "schema:identifier",
    "contentSize": "schema:contentSize",
    "duration": "schema:duration",
    "encodingFormat": "schema:encodingFormat",
    "dateCreated": "schema:dateCreated",
    "expires": "schema:expires",
    "AudioObject": "schema:AudioObject",
    "Organization": "schema:Organization",
    "SoftwareApplication": "schema:SoftwareApplication",
    "SourceFile": "lalal:SourceFile",
    "Stem": "lalal:Stem",
    "StemSeparationTask": "lalal:StemSeparationTask",
    "VoiceCleanTask": "lalal:VoiceCleanTask",
    "VoiceChangeTask": "lalal:VoiceChangeTask",
    "MultistemTask": "lalal:MultistemTask",
    "DemuserTask": "lalal:DemuserTask",
    "VoicePack": "lalal:VoicePack",
    "Splitter": "lalal:Splitter",
    "splitter": {"@id": "lalal:splitter", "@type": "lalal:Splitter"},
    "stem": {"@id": "lalal:stem"},
    "stemList": {"@id": "lalal:stemList", "@container": "@list"},
    "stemTrack": {"@id": "lalal:stemTrack", "@type": "@id"},
    "backTrack": {"@id": "lalal:backTrack", "@type": "@id"},
    "taskId": "lalal:taskId",
    "sourceId": "lalal:sourceId",
    "voicePackId": "lalal:voicePackId",
    "accent": "lalal:accent",
    "tonalityReference": "lalal:tonalityReference",
    "dereverbEnabled": "lalal:dereverbEnabled",
    "noiseCancellingLevel": "lalal:noiseCancellingLevel",
    "extractionLevel": "lalal:extractionLevel",
    "multivocal": "lalal:multivocal",
    "progress": "lalal:progress",
    "status": "lalal:status",
    "minutesLeft": "lalal:minutesLeft",
    "minutesUsed": "lalal:minutesUsed",
    "plan": "lalal:plan"
  }
}
